# Zoho Mail SMTP — formulario de contato
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contato@semtalentostudio.com.br
SMTP_PASS=sua-senha-ou-app-password
CONTACT_TO=contato@semtalentostudio.com.br

# Cloudflare R2 — arquivos STL (ver docs/stl-r2.md)
# Public URL (custom domain ou *.r2.dev), sem barra no final
NEXT_PUBLIC_STL_BASE_URL=https://files.semtalentostudio.com
# So no PC, para o script scripts/sync-stl-to-r2.mjs
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=semtalento-models
R2_PREFIX=models/3d
